+CREATE transaction:
+  si_no: "SEC-{timestamp}"
+  status: "Security Alert"
+  type: "system"
+  customer: "System"
+  amount: 0
+  notes: "Failed PIN attempt for Void on invoice {siNo}. Approver ID: {id}"
+```
